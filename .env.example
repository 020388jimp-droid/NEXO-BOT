# ── IA (Google AI Studio, capa gratuita) ─────────────────────────────
# Obtén una clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Opcional: fuerza un modelo. Por defecto se prueban varios en orden.
# GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=8000
# Presupuesto total de la IA por mensaje (para no bloquear el webhook)
# GEMINI_TOTAL_MS=9000

# ── Datos del negocio (todo es configurable) ─────────────────────────
BUSINESS_NAME=Clínica Dental Nova
BUSINESS_TZ=America/Mexico_City
BUSINESS_PHONE=+52 55 1234 5678
BUSINESS_EMAIL=hola@dentalnova.mx
BUSINESS_ADDRESS=Av. Reforma 123, Col. Centro, Ciudad de México
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=19
BUSINESS_SLOT_MINUTES=30
BUSINESS_DAYS=1,2,3,4,5,6

# ── Almacenamiento ───────────────────────────────────────────────────
# memoria  = local, se pierde al reiniciar
# firestore = producción en Google Cloud (se activa solo en Cloud Run)
ALMACEN=memoria

# ── WhatsApp Cloud API (opcional para la demo) ───────────────────────
# Se obtienen en https://developers.facebook.com/apps
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=nexo-bot-verificacion
META_API_VERSION=v21.0
# Número del dueño que recibe avisos de citas y solicitudes de asesor
OWNER_PHONE=

# ── Demo web ─────────────────────────────────────────────────────────
PORT=8080
PUBLIC_URL=http://localhost:8080
DEMO_MAX_MENSAJES=40
